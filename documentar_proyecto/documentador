#!/bin/bash

# =============================================================================
# Script: documentador.sh
# Descripción: Genera un archivo Markdown con el árbol y contenido del proyecto.
#              Opciones:
#                -a elem1 ...  -> Solo incluir esos elementos (allowlist)
#                -I elem1 ...  -> Excluir elementos (denylist)
#              Sin -a: se incluye todo excepto -I y el script/archivo de salida.
#              Exclusiones automáticas (siempre activas):
#                - Todo lo que empiece por .git (.git, .gitignore, ...)
#                - Archivos o directorios llamados exactamente .env
# Uso: ./documentador.sh [-a incl...] [-I excl...]
# =============================================================================

set -eo pipefail

# -----------------------------------------------------------------------------
# Funciones auxiliares
# -----------------------------------------------------------------------------

timestamp_ms() {
    if date +%s%3N 2>/dev/null | grep -qE '^[0-9]+$'; then
        date +%s%3N
    else
        echo "$(date +%s)$(printf "%03d" $((RANDOM % 1000)))"
    fi
}

# Escapar caracteres especiales para regex (no se usa directamente pero lo dejo)
escape_regex() {
    printf '%s' "$1" | sed 's/[.*+?[\]{}()|^$]/\\&/g'
}

# Determina si una ruta (relativa al directorio actual, sin "./" inicial)
# debe ser excluida según la lista de exclusión (incluye el script, el archivo
# de salida y las exclusiones automáticas de .git* / .env)
debe_excluir() {
    local rel="$1"
    
    # --- Exclusiones automáticas ---
    # .git* (cualquier ruta que empiece con .git)
    if [[ "$rel" == .git* ]]; then
        return 0
    fi
    # .env (archivo o directorio llamado exactamente .env)
    local base=$(basename "$rel")
    if [[ "$base" == ".env" ]]; then
        return 0
    fi
    
    # Excluir el script actual y el archivo de salida (siempre)
    [[ "$rel" == "$SCRIPT_REL" || "$rel" == "$OUTPUT_FILE" ]] && return 0
    
    for excl in "${EXCLUDE_ITEMS[@]}"; do
        excl_clean="${excl%/}"
        if [[ -d "$excl_clean" ]]; then
            # Si la exclusión es un directorio, la ruta debe ser igual o estar dentro
            if [[ "$rel" == "$excl_clean" || "$rel" == "$excl_clean"/* ]]; then
                return 0
            fi
        else
            # Exclusión exacta para archivo
            if [[ "$rel" == "$excl_clean" ]]; then
                return 0
            fi
        fi
    done
    return 1
}

# Generar árbol a partir de una lista de rutas (stdin: una ruta por línea, relativas)
# Usa awk para formatear jerárquicamente.
generar_arbol_desde_lista() {
    awk '
    BEGIN {
        indent = "    "
    }
    {
        # Eliminar "./" inicial si existe
        path = $0
        gsub(/^\.\//, "", path)
        if (path == "") path = "."
        
        # Dividir en componentes
        n = split(path, parts, "/")
        
        # Construir prefijo de indentación
        prefix = ""
        for (i = 1; i < n; i++) {
            prefix = prefix indent
        }
        
        # Determinar si es directorio (si el path existe y es directorio en el sistema)
        is_dir = (system("[ -d \"" $0 "\" ]") == 0)
        suffix = (is_dir && path != ".") ? "/" : ""
        
        # Último componente
        last = parts[n]
        if (path == ".") {
            print "."
        } else {
            printf "%s├── %s%s\n", prefix, last, suffix
        }
    }'
}

# Recolectar archivos desde una lista de elementos (incluyendo recursión)
recolectar_archivos_desde_items() {
    local items=("$@")
    for item in "${items[@]}"; do
        item_clean="${item%/}"
        if [[ -f "$item_clean" ]]; then
            echo "$item_clean"
        elif [[ -d "$item_clean" ]]; then
            find "$item_clean" -type f -print0 2>/dev/null | while IFS= read -r -d '' f; do
                echo "${f#./}"
            done
        fi
    done | sort -u
}

# Recolectar todas las rutas (archivos y directorios) para el árbol,
# partiendo de los elementos incluidos (si los hay) o de todo el proyecto.
# Aplica exclusiones.
recolectar_rutas_arbol() {
    if [[ ${#INCLUDE_ITEMS[@]} -eq 0 ]]; then
        # Modo completo: obtener todas las rutas (archivos y directorios) excepto excluidos
        # Usamos find para obtener todo (tanto archivos como directorios) y luego filtramos
        find . \( -type f -o -type d \) -print0 2>/dev/null | while IFS= read -r -d '' r; do
            rel="${r#./}"
            if debe_excluir "$rel"; then
                continue
            fi
            # Para directorios, añadimos también todas las subrutas implícitas? find ya las lista.
            echo "$rel"
        done | sort -u
    else
        # Modo allowlist: obtener todas las rutas dentro de los elementos incluidos
        declare -A all_paths
        for incl in "${INCLUDE_ITEMS[@]}"; do
            incl_clean="${incl%/}"
            if [[ -f "$incl_clean" ]]; then
                all_paths["$incl_clean"]=1
            elif [[ -d "$incl_clean" ]]; then
                # Listar todos los archivos y directorios dentro (find)
                while IFS= read -r -d '' r; do
                    rel="${r#./}"
                    if ! debe_excluir "$rel"; then
                        all_paths["$rel"]=1
                    fi
                done < <(find "$incl_clean" \( -type f -o -type d \) -print0 2>/dev/null)
            fi
        done
        printf "%s\n" "${!all_paths[@]}" | sort -u
    fi
}

# -----------------------------------------------------------------------------
# Inicialización
# -----------------------------------------------------------------------------

SCRIPT_REAL=$(realpath "$0" 2>/dev/null || readlink -f "$0")
SCRIPT_REL=$(basename "$SCRIPT_REAL")
TIMESTAMP=$(timestamp_ms)
OUTPUT_FILE="mapa_proyecto_${TIMESTAMP}.md"

INCLUDE_ITEMS=()    # Elementos a incluir (allowlist)
EXCLUDE_ITEMS=()    # Elementos a excluir (denylist - se añadirán automáticos más abajo)

# -----------------------------------------------------------------------------
# Parseo de argumentos (soporta -a y -I en cualquier orden)
# -----------------------------------------------------------------------------
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
    case "${args[$i]}" in
        -a)
            i=$((i+1))
            while [[ $i -lt ${#args[@]} && "${args[$i]}" != "-I" ]]; do
                INCLUDE_ITEMS+=("${args[$i]}")
                i=$((i+1))
            done
            ;;
        -I)
            i=$((i+1))
            while [[ $i -lt ${#args[@]} && "${args[$i]}" != "-a" ]]; do
                EXCLUDE_ITEMS+=("${args[$i]}")
                i=$((i+1))
            done
            ;;
        *)
            echo "Advertencia: argumento no reconocido '${args[$i]}'. Se omite." >&2
            i=$((i+1))
            ;;
    esac
done

# Añadir exclusiones automáticas (adicionales a las del usuario)
EXCLUDE_ITEMS+=("$SCRIPT_REL")
EXCLUDE_ITEMS+=("$OUTPUT_FILE")
# Nota: las exclusiones .git* y .env están implementadas directamente en debe_excluir
# para mayor claridad y rendimiento, no se añaden como elementos literales aquí.

# -----------------------------------------------------------------------------
# 1. Generar el árbol del proyecto
# -----------------------------------------------------------------------------
{
    echo "# Estructura del proyecto"
    echo '```'
    # Recolectar rutas y pasarlas al generador de árbol
    recolectar_rutas_arbol | generar_arbol_desde_lista
    echo '```'
    echo ""
} > "$OUTPUT_FILE"

# -----------------------------------------------------------------------------
# 2. Volcado del contenido de los archivos (solo archivos, no directorios)
# -----------------------------------------------------------------------------
escribir_archivo() {
    local file="$1"
    local rel="${file#./}"
    
    # Filtro de exclusión (redundante pero seguro)
    if debe_excluir "$rel"; then
        return
    fi
    
    # Verificar tipo MIME
    mime=$(file --mime-type -b "$file" 2>/dev/null || true)
    case "$mime" in
        text/*|application/x-shellscript|application/json|application/javascript|application/x-lua|application/xml|application/yaml)
            ;;
        *)
            return
            ;;
    esac
    
    {
        echo ""
        echo "## Archivo: $rel"
        echo '```'
        cat "$file"
        echo '```'
    } >> "$OUTPUT_FILE"
}

# Recolectar archivos según la modalidad (con o sin -a)
if [[ ${#INCLUDE_ITEMS[@]} -eq 0 ]]; then
    # Modo completo: todos los archivos excepto exclusiones
    find . -type f -print0 2>/dev/null | while IFS= read -r -d '' file; do
        rel="${file#./}"
        debe_excluir "$rel" && continue
        escribir_archivo "$file"
    done
else
    # Modo allowlist: solo archivos dentro de INCLUDE_ITEMS (aplicando exclusiones después)
    archivos_procesar=$(recolectar_archivos_desde_items "${INCLUDE_ITEMS[@]}")
    while IFS= read -r rel; do
        if debe_excluir "$rel"; then
            continue
        fi
        # Asegurar que existe (por si hay directorios vacíos)
        if [[ -f "$rel" ]]; then
            escribir_archivo "$rel"
        fi
    done <<< "$archivos_procesar"
fi

echo "✅ Documentación generada en: $OUTPUT_FILE"
