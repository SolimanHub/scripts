#!/bin/bash
# ~/.local/bin/dime
# Devuelve el comando exacto para tu SO usando IA (Mistral API o Ollama local)

set -euo pipefail

# --- Configuración por defecto ---
: "${OLLAMA_MODEL:=dolphincoder:7b}"             # Modelo por defecto para Ollama
: "${OLLAMA_URL:=http://localhost:11434}" # URL de Ollama

# --- Funciones auxiliares ---
error() { echo -e "\033[31mError: $*\033[0m" >&2; }
exito() { echo -e "\033[32m$*\033[0m"; }

# Detección del sistema operativo
detectar_so() {
    case "$(uname -s)" in
        Linux)
            if [ -f /etc/os-release ]; then
                # shellcheck source=/dev/null
                . /etc/os-release
                echo "${PRETTY_NAME:-${NAME:-Linux}}"
            else
                echo "Linux"
            fi
            ;;
        Darwin)  echo "macOS" ;;
        CYGWIN*|MINGW*|MSYS*) echo "Windows (PowerShell)" ;;
        *)       echo "$(uname -s)" ;;
    esac
}

# --- Llamadas a las APIs ---

usar_mistral() {
    [ -z "${MISTRAL_API_KEY:-}" ] && return 1

    local payload respuesta comando
    payload=$(jq -n \
        --arg model "mistral-small-latest" \
        --arg content "$prompt" \
        '{model: $model, messages: [{role: "user", content: $content}], temperature: 0.3}')

    respuesta=$(curl -sS --max-time 10 \
        -X POST "https://api.mistral.ai/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $MISTRAL_API_KEY" \
        -d "$payload") || return 1

    comando=$(echo "$respuesta" | jq -r '.choices[0].message.content')
    [ -z "$comando" ] || [ "$comando" = "null" ] && return 1

    exito "$comando"
    return 0
}

usar_ollama() {
    local payload respuesta comando modelo
    modelo="${OLLAMA_MODEL:-llama3}"

    payload=$(jq -n \
        --arg model "$modelo" \
        --arg prompt "$prompt" \
        '{model: $model, prompt: $prompt, stream: false, temperature: 0.1}')

    respuesta=$(curl -sS --max-time 30 \
        -X POST "$OLLAMA_URL/api/generate" \
        -H "Content-Type: application/json" \
        -d "$payload") || return 1

    comando=$(echo "$respuesta" | jq -r '.response')
    [ -z "$comando" ] || [ "$comando" = "null" ] && return 1

    exito "$comando"
    return 0
}

# --- Principal ---

# Ayuda
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Uso: dime <consulta>"
    echo "Obtiene un comando de terminal adecuado para tu sistema operativo usando IA."
    exit 0
fi

# Verificar dependencias
for cmd in curl jq; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        error "Necesitas tener instalado '$cmd'. Instálalo con tu gestor de paquetes."
        exit 1
    fi
done

# Verificar que hay consulta
if [ $# -lt 1 ]; then
    error "Uso: dime <consulta>"
    exit 1
fi

# Construir prompt adaptado al SO detectado
so=$(detectar_so)
prompt="Responde solo con el comando exacto para $so, sin texto adicional, explicaciones, markdown ni formato extra. Si añades algo más, la respuesta será inválida. Ejemplo correcto: ls -la. Ejemplo incorrecto: 'El comando es: ls'. Ahora, dame solo el comando para: $*"

# Intentar Mistral primero, luego Ollama local
if usar_mistral; then
    exit 0
elif usar_ollama; then
    exit 0
else
    error "No se pudo conectar a ningún servicio de IA. Revisa tu conexión o configuración."
    exit 1
fi
